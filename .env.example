# Copy to .env and fill in. Never commit .env.

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent with a contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="FilingsQA your.name@example.com"
SEC_MAX_REQUESTS_PER_SECOND=10

# --- Generator LLM (the system under test) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_TEMPERATURE=0
ANTHROPIC_API_KEY=

# --- Judge LLM (evaluation only; configured separately on purpose) ---
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-sonnet-5-5
JUDGE_TEMPERATURE=0

# --- LLM response cache (dev cost control) ---
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.cache/llm

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=filings

# --- Embeddings (local, no API cost) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
