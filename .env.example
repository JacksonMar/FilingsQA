# Copy to .env and fill in. Never commit .env.

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent with a contact email.
# https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="FilingsQA your.name@example.com"
SEC_MAX_REQUESTS_PER_SECOND=10

# --- Generator LLM (the system under test) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# Current Claude models accept only default sampling params, so there is no temperature
# setting (ADR-013). Effort controls thinking depth/cost: low | medium | high | xhigh | max.
LLM_EFFORT=low
LLM_MAX_TOKENS=4096
ANTHROPIC_API_KEY=

# --- Judge LLM (evaluation only; configured separately on purpose) ---
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-sonnet-5-5
JUDGE_EFFORT=medium

# --- LLM response cache (dev cost control) ---
LLM_CACHE_ENABLED=true
LLM_CACHE_DIR=.cache/llm

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=filings

# --- Embeddings (local, no API cost) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
# Where fastembed stores downloaded models (default: system temp dir, lost on reboot).
# FASTEMBED_CACHE_PATH=.cache/fastembed

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_PREFETCH_K=40
